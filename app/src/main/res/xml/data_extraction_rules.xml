<?xml version="1.0" encoding="utf-8"?>
<!-- Android-back-up (Android 12 en nieuwer): de database en de instellingen, niet de plaatjes of de wachtrij. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="ninegrid.db" />
        <include domain="database" path="ninegrid.db-wal" />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="ninegrid.db" />
        <include domain="database" path="ninegrid.db-wal" />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
